# CineVibe Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# ============================================
# Flask Configuration
# ============================================
# Generate a strong secret key with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here-generate-with-secrets-token-hex-64-chars

# ============================================
# Google Cloud Configuration
# ============================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-with-restrictions

# ============================================
# AI Service API Keys
# ============================================
# Runway ML API
RUNWAY_API_KEY=your-runway-api-key

# Pika API
PIKA_API_KEY=your-pika-api-key

# Midjourney API
MIDJOURNEY_API_KEY=your-midjourney-api-key

# Stability AI API
STABILITY_AI_API_KEY=your-stability-ai-api-key

# ============================================
# Database Configuration
# ============================================
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/cinevibe

# ============================================
# Claude AI Configuration
# ============================================
# WARNING: Keep Claude credentials in a separate secure location
# Consider using Google Secret Manager for production
# DO NOT store OAuth tokens in .env files
# CLAUDE_ACCESS_TOKEN=manage-via-claude-cli
# CLAUDE_REFRESH_TOKEN=manage-via-claude-cli

# ============================================
# Application Settings
# ============================================
# Environment: development, staging, production
FLASK_ENV=development
DEBUG=True

# Application Port
PORT=8080

# ============================================
# Security Notes
# ============================================
# 1. Never commit the actual .env file to version control
# 2. Use strong, randomly generated values for all secrets
# 3. Rotate API keys regularly
# 4. Use Google Secret Manager for production deployments
# 5. Restrict API keys to specific IPs/domains where possible
# 6. Enable API key monitoring and alerts in Google Cloud Console
