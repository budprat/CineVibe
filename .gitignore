# CineVibe .gitignore
# Security-focused configuration to prevent exposure of secrets and credentials

# ============================================
# Environment Files - CRITICAL
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# ============================================
# Secret Files and Credentials - CRITICAL
# ============================================
# API Keys and Secrets
*.key
*.pem
*.p12
*.pfx
credentials.json
*credentials*.json
service-account*.json
mapkey.txt
project_id.txt
secrets.json
secrets.yaml

# Claude AI
.claude/
.claude.json
.credentials.json

# Gemini
.gemini/

# Google Cloud
gcloud-credentials.json
service-account-key.json

# ============================================
# Shell History - SECURITY RISK
# ============================================
.bash_history
.zsh_history
.sh_history

# ============================================
# Python
# ============================================
# Virtual Environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# ============================================
# Node / JavaScript
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.yarn-integrity

# ============================================
# IDEs and Editors
# ============================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============================================
# Database
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# Logs
# ============================================
logs/
*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ============================================
# Docker
# ============================================
docker-compose.override.yml

# ============================================
# Cloud Build
# ============================================
# Keep cloud build yamls but ignore generated files
.gcloudignore

# ============================================
# Application Specific
# ============================================
# a2a-inspector
a2a-inspector/frontend/dist/
a2a-inspector/.nox/

# instavibe-bootstrap
instavibe-bootstrap/env/

# ============================================
# Security Scanning Results (optional)
# ============================================
.secrets.baseline
trufflehog-report.json
security-scan-results.txt
